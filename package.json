{
  "name": "riffly-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev:mobile": "yarn workspace @riffly/mobile start",
    "dev:api": "yarn workspace @riffly/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "latest"
  }
}
